# Translated from ~/.config/kitty/kitty.conf.

# Font and cell metrics
font-family = Operator Mono SSm Lig
font-size = 19
font-style = bold
font-feature = +calt
adjust-cell-height = 12

# Restore windows, tabs, splits, and working directories
window-save-state = always

# Give Cmd+Z more time to restore accidentally closed terminals
undo-timeout = 30s

# Fixes https://github.com/ghostty-org/ghostty/discussions/5012
# solves the backspace problem if you ssh into dev workspace
shell-integration-features = true

# Exact colors from Kitty's gruvbox_dark.conf. Ghostty's built-in
# "Gruvbox Dark Hard" theme uses a slightly different background and palette.
#background = #282828
#foreground = #ebdbb2
#cursor-color = #928374
#selection-foreground = #928374
#selection-background = #3c3836
#palette = 0=#282828
#palette = 1=#cc241d
#palette = 2=#98971a
#palette = 3=#d79921
#palette = 4=#458588
#palette = 5=#b16286
#palette = 6=#689d6a
#palette = 7=#a89984
#palette = 8=#928374
#palette = 9=#fb4934
#palette = 10=#b8bb26
#palette = 11=#fabd2d
#palette = 12=#83a598
#palette = 13=#d3869b
#palette = 14=#8ec07c
#palette = 15=#928374

# Mouse, clipboard, and bell behavior
copy-on-select = true
# Closest match to Kitty's "smart" trimming. Ghostty also trims rectangular
# selections because it exposes only a boolean setting.
clipboard-trim-trailing-spaces = true
focus-follows-mouse = true
clipboard-read = allow
clipboard-write = allow
bell-features = no-audio
macos-option-as-alt = left

# Kitty keybindings with direct Ghostty equivalents
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+s=paste_from_selection
keybind = ctrl+enter=text:\x1b[13;5u
keybind = ctrl+minus=text:\x1b[45;5u

# Closest available mappings:
# - Kitty's scrollback pager is replaced by a plain temporary file opened in
#   the default editor; Ghostty has no separate 4000 MB pager-history buffer.
# - Kitty's stack layout is replaced by split zoom.
keybind = ctrl+shift+h=write_scrollback_file:open
keybind = ctrl+shift+m=toggle_split_zoom

# No Ghostty 1.3.1 equivalents:
# - ctrl+shift+o: pass the selection to its default program
# - ctrl+shift+r: enter Kitty's interactive resize mode
# - ctrl+shift+l: cycle Kitty layouts
